---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout
  title="Keeli Belotti — Writing"
  description="Essays and notes by Keeli Belotti."
>
  <section class="page-intro">
    <h1>Writing</h1>
    <p>Essays, notes, and things worth putting into words.</p>
  </section>

  {
    posts.length === 0 ? (
      <p class="empty-state">No posts yet. The first one is on its way.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-meta">{formatDate(post.data.pubDate)}</p>
              {post.data.description && (
                <p class="post-excerpt">{post.data.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
